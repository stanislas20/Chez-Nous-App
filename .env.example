# Copy this file to .env and fill in the values from your Firebase project:
# Firebase Console -> Project settings -> General -> Your apps -> Web app config
#
# Steps to create these:
# 1. Go to https://console.firebase.google.com and create a project.
# 2. Authentication -> Sign-in method -> enable "Email/Password".
# 3. Firestore Database -> Create database (production mode is fine).
# 4. Project settings -> add a Web app -> copy the config values below.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# There is deliberately NO Places key here.
#
# Every EXPO_PUBLIC_* variable in .env is inlined into the JavaScript bundle
# by Metro, whether or not any code reads it — so a Places key placed here
# ships inside the APK and the IPA and can be lifted out of either with
# unzip. That is exactly what happened before Phase E: the app had already
# stopped reading the variable, and the key was still compiled into every
# build.
#
# The Places key is a Cloud Functions secret and never leaves the server:
#
#   firebase functions:secrets:set GOOGLE_PLACES_API_KEY
#
# functions/placesProxy.js reads it with defineSecret. scripts/check-bundle-
# secrets.js exports the real bundle and fails the build if a Google API key
# that should be server-only appears in it.
