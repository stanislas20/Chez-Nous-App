# Copy this file to .env and fill in the values from your Firebase project:
# Firebase Console -> Project settings -> General -> Your apps -> Web app config
#
# Steps to create these:
# 1. Go to https://console.firebase.google.com and create a project.
# 2. Authentication -> Sign-in method -> enable "Email/Password".
# 3. Firestore Database -> Create database (production mode is fine).
# 4. Project settings -> add a Web app -> copy the config values below.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Cloud Console -> APIs & Services -> enable "Places API" (legacy, not
# "Places API (New)") on the same project as your Maps API key, then either
# reuse that key here or create a separate one restricted to Places API.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
