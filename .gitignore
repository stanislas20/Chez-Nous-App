# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Service-account credentials. The key lives outside this repo and should stay
# there — this is here so that copying one in for "just a second" cannot end
# up in a commit. A leaked admin key reads every private message in the
# database and mints a token for any account; it is not a file that can be
# quietly rotated after the fact.
*service-account*.json
*serviceaccount*.json
*-firebase-adminsdk-*.json
google-application-credentials.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# IDE
.idea/

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Emulator output, regenerated on every rules test run.
firestore-debug.log
firebase-debug.log
