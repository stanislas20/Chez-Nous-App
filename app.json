{
  "expo": {
    "name": "Chez-Nous",
    "slug": "chez-nous",
    "owner": "stanislas20",
    "scheme": "cheznous",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stanislas20.cheznous",
      "buildNumber": "2",
      "googleServicesFile": "./GoogleService-Info.plist",
      "appleTeamId": "MY9Y7Y46Q7",
      "entitlements": {
        "aps-environment": "development"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "UIRequiresFullScreen": true
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#008751",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.stanislas20.cheznous",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "pan",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDFtLrWLImqkIS3JzqGRas-qLtrVv5ZaMk"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00553A",
          "image": "./assets/splash-mark.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#00553A"
          }
        }
      ],
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging",
              "RNFBAppCheck",
              "RNFBCrashlytics"
            ],
            "deploymentTarget": "16.4"
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ],
      "./plugins/withHermesAlwaysOutOfDate",
      "./plugins/withExpoConstantsSpaceInPathFix",
      "./plugins/withRNFirebaseAsStaticFramework",
      "./plugins/withRNFBAlwaysOutOfDate",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Chez-Nous to access your photos to upload an ad or attach a scanned document.",
          "cameraPermission": "Allow Chez-Nous to use your camera to take a photo of an ad item or scan a document."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Chez-Nous to access your microphone to record voice messages and search by voice."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Chez-Nous to use your location to suggest the nearest pharmacy on duty."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Chez-Nous to access your microphone to record voice messages and search by voice.",
          "speechRecognitionPermission": "Allow Chez-Nous to use speech recognition for voice search.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      "@react-native-firebase/app-check",
      "@react-native-firebase/crashlytics"
    ],
    "extra": {
      "eas": {
        "projectId": "e9de94fe-41a8-4b37-a9fb-95cd7c07e5be"
      }
    }
  }
}
