rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sellers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // A company account can submit its own RCCM/IFU/documents, but can
      // never write itself straight to 'verified' — this is the one and
      // only place that field is ever set, and it can only start at
      // 'pending' here (or be entirely absent, for individual accounts).
      //
      // `verifiedAt` may be present as long as it is null. `in` tests for
      // the key, not for a meaningful value, so requiring the key to be
      // absent rejected the client's own `verifiedAt: null` — which is how
      // signUpCompanySeller declares the field's initial state. That
      // mismatch denied every single company signup while leaving the auth
      // user created. Permitting an explicit null gives up nothing: a real
      // timestamp is still rejected, so the badge still can't be self-
      // granted.
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == 'pending')
        && (!('verifiedAt' in request.resource.data) || request.resource.data.verifiedAt == null);

      // Everything else about a seller's own profile stays freely
      // editable, but verificationStatus/verifiedAt are frozen from the
      // client's point of view after creation — those two only ever
      // change via the Admin SDK, i.e. an actual manual review, never
      // through the app itself.
      //
      // Once verified, the identity the review actually checked is frozen
      // too. Without this a company could clear manual review and then edit
      // its RCCM, IFU or trading name while keeping the badge — leaving a
      // Verified mark attesting to details nobody ever saw. Before
      // approval these stay editable, so a typo can still be corrected.
      // The status may also go from absent to 'pending' — that is a company
      // submitting its file for the first time onto a document some other
      // write created first (a push token, a seen-cursor). Without this the
      // company signup failed outright: the profile write became an update,
      // the status moved null -> 'pending', and the rule refused it. Only
      // that one transition is permitted; 'verified' remains impossible from
      // the client, which is the property this rule exists to protect.
      allow update: if request.auth != null && request.auth.uid == userId
        && (
          request.resource.data.get('verificationStatus', null) == resource.data.get('verificationStatus', null)
          || (resource.data.get('verificationStatus', null) == null
            && request.resource.data.get('verificationStatus', null) == 'pending')
        )
        && request.resource.data.get('verifiedAt', null) == resource.data.get('verifiedAt', null)
        && (
          resource.data.get('verificationStatus', '') != 'verified'
          || (
            request.resource.data.get('companyName', '') == resource.data.get('companyName', '')
            && request.resource.data.get('rccm', '') == resource.data.get('rccm', '')
            && request.resource.data.get('ifu', '') == resource.data.get('ifu', '')
          )
        );

      // The durable half of a push notification.
      //
      // A push is a delivery attempt with no memory: once the banner is
      // gone the notification is gone, and the notification centre — built
      // from unread conversations, newly approved listings and job
      // applications — never knew about it in the first place. That is why
      // tapping "Voir" on a pharmacy roster alert landed on "no
      // notifications yet". These rows are what the centre reads so that a
      // notification the reader was shown is a notification they can find.
      //
      // Read by the owner and nobody else. Written by the Admin SDK only:
      // every one of these is a statement the SERVER is making — a roster
      // is waiting, a sync failed — and a client that could write them
      // could manufacture one. `write` covers create, update and delete
      // together on purpose; a reader who could delete their own could
      // clear the record of a roster they never applied, which is the one
      // thing this row exists to prevent them doing quietly.
      //
      // Nested rather than nested-under-a-wildcard: rules do not cascade
      // into subcollections, so without this block the collection would be
      // unreadable rather than owner-readable, and the centre would be
      // empty for a second reason.
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Public projection of a verified company — name, sector, city, logo,
    // and nothing else. Deliberately world-readable (the home feed shows it
    // to signed-out browsers too) precisely so that `sellers`, which holds
    // the phone number, RCCM, IFU and the representative's ID document, can
    // stay locked to its owner. Written only by the Admin SDK via
    // notifyCompanyVerificationDecision: no client write of any kind, so a
    // company cannot list itself here any more than it can grant itself the
    // badge.
    match /verifiedCompanies/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /advertisers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /ads/{adId} {
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && request.auth.uid == resource.data.advertiserId);

      // Same rule as listings: an advertisement is published content, and
      // Chez-Nous publishes from Bénin. The advertiser sign-up already
      // insists on a Bénin number, so this is the second lock rather than
      // the first — but the first one is in the app, and the app is not
      // where a determined writer goes.
      allow create: if request.auth != null
        && request.auth.token.canPost == true
        && request.resource.data.advertiserId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if request.auth != null
        && request.auth.uid == resource.data.advertiserId
        && resource.data.status != 'approved'
        && request.resource.data.status == resource.data.status;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.advertiserId
        && resource.data.status != 'approved';
    }

    // Null is the ordinary case: the field only exists on a listing whose
    // category or trade is "other".
    function customCategoryOk(data, field) {
      return data.get(field, null) == null
        || (data[field] is string && data[field].size() <= 40);
    }

    // ── What a seller is allowed to assert about their own listing ────────
    //
    // Everything below exists for one reason: the client writes the whole
    // listing document, and until now the only fields this file checked were
    // sellerId, status, isPromoted, promotedUntil and the two custom-category
    // strings. Every other key on the document was whatever the phone sent.
    // That is fine for a title and a price, which a moderator reads, and not
    // fine for the fields that are claims about somebody else's decision.

    // The Vérifié badge, and its second copy on a job post.
    //
    // A buyer cannot read sellers/{uid} — that rule is what keeps RCCM, IFU
    // and the representative's ID off the wire — so the badge travels
    // denormalised on the listing. The cost of that is this: the field was
    // written from the phone, believed by every card that renders it, and
    // filtered out of the moderation screen as plumbing. So the one claim in
    // this app that means "a human checked this against the national
    // registry" could be self-granted, and the human checking would never
    // see it.
    //
    // It can now only start false. autoPublishVerifiedCompanyListing stamps
    // it true a moment later for a seller who has actually been through
    // review, and backfillVerifiedBadge stamps the back catalogue when
    // review comes back — both under the Admin SDK, which bypasses these
    // rules. `verified` is the same fact under a second name on job posts;
    // freezing one and not the other would move the hole rather than close
    // it.
    function badgeUnclaimed(data) {
      return data.get('sellerVerified', false) == false
        && data.get('verified', false) == false;
    }

    // Counters and moderation stamps are nobody's to seed.
    //
    // A listing created carrying viewCount: 4000 arrives in the market
    // already looking wanted, and approvedAt/moderatedBy written at create
    // are an audit trail forged before anyone audited anything. All of them
    // are written later by somebody else — the counter rules below, the
    // Cloud Function triggers, a moderator — so at create they must simply
    // be absent.
    function countersUnseeded(data) {
      return !data.keys().hasAny([
        'viewCount', 'viewCountToday', 'viewCountDate',
        'shareCount', 'contactCount', 'contactCountToday', 'contactCountDate',
        'saveCount', 'reportCount', 'lastReportedAt',
        'approvedAt', 'moderatedBy', 'moderatedAt', 'moderationNote',
      ]);
    }

    // A listing's own lifetime, bounded rather than trusted.
    //
    // expiresAt is the only thing keeping the catalogue from growing
    // forever, and it is written by the client — at publish, and again on
    // every renewal from the dashboard. A seller who sets it to the year
    // 3000 never renews anything again.
    //
    // 120 days rather than the 90 a verified company actually gets, and
    // deliberately: the client computes this from the DEVICE clock
    // (getListingExpiresAtTimestamp uses Date.now()), and a phone running
    // fast would otherwise have every publish refused with nothing on
    // screen explaining why. A month of headroom absorbs any clock skew
    // worth tolerating and still refuses a decade.
    //
    // Only the upper bound is checked. A date in the past merely hides the
    // seller's own listing, which is not an attack on anybody else, and
    // enforcing a lower bound would break a phone whose clock runs slow.
    function expiresAtOk(data) {
      return data.get('expiresAt', null) == null
        || (data.expiresAt is timestamp
          && data.expiresAt < request.time + duration.value(120, 'd'));
    }

    // Length, on the server, where it binds.
    //
    // No input in the posting form carries maxLength today, and neither did
    // this file, so a listing could hold a pasted document up to Firestore's
    // 1 MiB ceiling — paid for on every read, by every reader, on a feed
    // that currently downloads the whole collection.
    //
    // The ceilings are generous against real content: the longest
    // description anywhere in the bundled data is 323 characters and the
    // longest title 39. 5000 is roughly 800 words, which is a long job
    // posting and not a pasted PDF.
    function textOk(data, field, max) {
      return data.get(field, null) == null
        || (data[field] is string && data[field].size() <= max);
    }

    // Belt and braces on the array the server writes.
    //
    // Nothing that reaches this rule should carry searchTokens at all — the
    // create rule refuses them and the owner-update rule freezes them, and
    // the Admin SDK bypasses rules entirely. This is the third line anyway,
    // because the field is on a document every reader downloads and an
    // unbounded array there is a document-size problem for everybody. Matches
    // SEARCH_TOKEN_MAX in src/utils/searchTokens.js, checked by
    // scripts/check-search-tokens.js.
    function searchTokensOk(data) {
      return !('searchTokens' in data)
        || (data.searchTokens is list && data.searchTokens.size() <= 40);
    }

    // The pair index, held to the same three rules as searchTokens above:
    // refused at create, frozen on an owner update, and bounded here as the
    // third line. C(14,2) is 91, so 100 is the writers' ceiling with headroom
    // and nothing legitimate approaches it. Matches SEARCH_PAIR_MAX in
    // src/utils/searchTokens.js, checked by scripts/check-search-tokens.js.
    function searchPairsOk(data) {
      return !('searchPairs' in data)
        || (data.searchPairs is list && data.searchPairs.size() <= 100);
    }

    function listingTextOk(data) {
      return textOk(data, 'titleFr', 120)
        && textOk(data, 'titleEn', 120)
        && textOk(data, 'title', 120)
        && textOk(data, 'descriptionFr', 5000)
        && textOk(data, 'descriptionEn', 5000)
        && textOk(data, 'description', 5000);
    }

    // FCFA, and a ceiling high enough for the most expensive thing anybody
    // could honestly sell here. Ten billion FCFA is around fifteen million
    // euro — well above any Cotonou property — while still refusing the
    // overflow-shaped numbers that make a card render nonsense.
    //
    // Zero is valid and common: listingPrice.js treats 0 as "no price
    // given" for jobs, pharmacies, restaurants and anything sur devis.
    function listingPriceOk(data) {
      return data.get('price', 0) is number
        && data.get('price', 0) >= 0
        && data.get('price', 0) <= 10000000000;
    }

    // ── E13: a counter that one account cannot ratchet ───────────────────
    //
    // viewCount, shareCount and contactCount were authenticated and otherwise
    // unlimited: any signed-in account could +1 any approved listing as fast
    // as it could write, inflating a rival's numbers or its own and billing
    // us a write each time.
    //
    // Rules cannot count events over time, and gating the increment on a
    // marker that merely EXISTS would be worse than nothing — create it once,
    // increment forever. So the marker does not gate the write; it REPLACES
    // it. The client no longer writes counters at all.
    //
    // It creates counterMarkers/{listingId}_{uid}_{kind}_{yyyy-mm-dd}, whose
    // id is the whole rate limit: Firestore refuses the second create of the
    // same id on its own, with no rule needed and nothing to trust. A
    // Cloud Function then does the increment with the Admin SDK, so the
    // number itself is server-authored — the same shape as searchTokens and
    // sellerVerified.
    //
    // One person can therefore move a listing's view count by one per day,
    // and each attempt after the first costs them a refused write and costs
    // us nothing.
    //
    // Deliberately not a security boundary. Displayed counts are a signal for
    // readers, not an audit trail, and somebody determined enough to make
    // accounts can still move them. What this stops is the cheap version: one
    // account, one loop, unlimited.
    // The day is the SERVER's, computed here, never the caller's.
    //
    // Phase E checked that `day` was a ten-character string and nothing more.
    // The re-audit showed what that was worth: the field is part of the
    // document id, so every distinct ten-character string is a distinct
    // document and therefore a distinct allowed create. One account produced
    // 55 accepted view markers for one listing in a single burst using
    // "0000000000", "0000000001", "aaaaaaaaaa" and so on. The rate limit was
    // decorative.
    //
    // request.time is the server's clock and cannot be moved by a caller, so
    // the bucket is derived from it and the client's value merely has to
    // agree. A future day, a past day and an invented string are all now the
    // same thing: a value that is not today, and refused.
    //
    // Zero-padded by hand because rules have no formatting: string(9) is "9"
    // and the id has to match what the client builds, which is
    // toISOString().slice(0, 10).
    function twoDigits(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function serverDay() {
      return string(request.time.year()) + '-'
        + twoDigits(request.time.month()) + '-'
        + twoDigits(request.time.day());
    }

    match /counterMarkers/{markerId} {
      allow read: if false;

      // The id is COMPOSED rather than parsed. Splitting on '_' and taking a
      // field by position looked equivalent and is not: a listing id
      // containing an underscore silently shifts every position after it, and
      // conversation ids in this same database are built that way.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['listingId', 'uid', 'kind', 'day', 'createdAt', 'expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['view', 'share', 'contact']
        && request.resource.data.day == serverDay()
        && request.resource.data.listingId is string
        && request.resource.data.listingId.size() > 0
        && markerId == request.resource.data.listingId + '_'
             + request.auth.uid + '_'
             + request.resource.data.kind + '_'
             + request.resource.data.day
        && request.resource.data.createdAt == request.time
        // Retention, bounded against the server clock rather than fixed to
        // it. The client computes this from its own Date.now(), which will
        // never equal request.time to the millisecond — an equality test here
        // would refuse every honest write. A window instead: far enough out
        // that the daily bucket always outlives its purpose, near enough that
        // nobody can ask to be remembered for a year.
        //
        // A device whose clock is more than a day out loses its counts. That
        // is the safe direction, and it is the same clock that would have
        // produced the wrong `day` anyway.
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time + duration.value(6, 'd')
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd');

      allow update, delete: if false;
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && request.auth.uid == resource.data.sellerId)
        // A moderator has to see what they are being asked to judge. The
        // write rule below already lets them change a status; without this
        // they could approve a listing they had never been able to open,
        // which is not moderation, it is a coin toss.
        || (request.auth != null && request.auth.token.moderator == true);

      // Publishing is Bénin-only, and this is the line that makes that true.
      //
      // The app hides its posting buttons from accounts that cannot use them,
      // but a hidden button stops only the honest — anyone can write to
      // Firestore with the SDK. `canPost` is a custom claim, so it can only
      // be set by the claimPhoneCountry function, and that function only sets
      // it from a phone number Firebase itself verified by SMS.
      //
      // Reading stays open to the world, above. Someone in Paris or Lagos can
      // browse everything, message any seller and call any number; they
      // cannot add to the market, because we cannot put an SMS through to
      // their handset and an unreachable seller is where the scams start.
      // A seller may ask to be featured. They may not grant it to
      // themselves. The publish form used to write isPromoted straight from
      // its route params, and nothing here disagreed — so the "paid
      // placement" the code talks about cost nothing and never ended.
      // promotionRequested is the seller's half and says only that they
      // asked; isPromoted and promotedUntil are a moderator's to write.
      allow create: if request.auth != null
        && request.auth.token.canPost == true
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.get('isPromoted', false) == false
        && !request.resource.data.keys().hasAny(['promotedUntil'])
        // Free text the seller writes, which every future seller is then
        // offered as a suggestion. That is the reason for the ceiling: an
        // unbounded "category" is a paragraph pasted into a chip row, on
        // everyone's screen, for as long as the listing is approved.
        // Matches CUSTOM_CATEGORY_MAX in src/data/customCategories.js.
        && customCategoryOk(request.resource.data, 'customCategory')
        && customCategoryOk(request.resource.data, 'customTrade')
        // See badgeUnclaimed: the Vérifié badge is granted by review, never
        // asserted by the account being reviewed.
        && badgeUnclaimed(request.resource.data)
        // Search tokens are the server's, not the seller's.
        //
        // A rule can check that an array is short and full of strings. What
        // it cannot check is that the words came from the title — and
        // `array-contains` does not care where a word came from. A client
        // that writes its own tokens can put "toyota", "corolla" and
        // "iphone" on a listing for a broken chair and turn up in all three
        // searches, invisibly, because the moderator reads the title and not
        // the token array.
        //
        // So it is refused here entirely and written by
        // syncListingSearchTokens from the document a moderator actually
        // read. Same shape, and the same reasoning, as sellerVerified.
        && !request.resource.data.keys().hasAny(['searchTokens', 'searchPairs'])
        && countersUnseeded(request.resource.data)
        && expiresAtOk(request.resource.data)
        && listingTextOk(request.resource.data)
        && listingPriceOk(request.resource.data)
        // The server's clock, not the phone's.
        //
        // Every browse query in the app orders by createdAt descending, so a
        // client-chosen date is a permanent place at the top of every feed —
        // set it to 2099 once and no honest listing ever appears above it
        // again. serverTimestamp() resolves to request.time here, so the
        // ordinary write passes and a literal date does not.
        //
        // Read through get() rather than as a bare property: a create that
        // omits the field entirely would otherwise make the whole rule
        // throw an evaluation error rather than simply return false, and a
        // rule that errors is a rule that is hard to read in the emulator
        // log next to the ones that merely denied.
        && request.resource.data.get('createdAt', null) == request.time;

      // A rejection has to be survivable.
      //
      // This line used to read `request.resource.data.status ==
      // resource.data.status`, full stop, and that made 'rejected' a
      // terminal state: the seller could edit the listing all they liked
      // and it stayed rejected, invisible to everyone, forever. Their only
      // way back was to delete it and post it again, losing the document,
      // its views and its history — and nothing told them that. Meanwhile
      // listingRejectedNoReason, on their own screen, said "Edit it and it
      // will be reviewed again". The app was promising the one thing this
      // rule refused.
      //
      // So one transition opens, in one direction: rejected -> pending, by
      // the owner. Nothing else moves. A seller still cannot approve
      // anything, cannot take an approved listing out of review, and cannot
      // reject somebody else's.
      //
      // canPost is required on that branch and not on an ordinary edit,
      // because re-entering the queue is publishing — the same act the
      // create rule gates — while fixing a typo on a listing already in the
      // market is not. An account whose claim has lapsed can still correct
      // what it has; it cannot put something new in front of a moderator.
      //
      // Deliberately not required: that anything actually changed. A seller
      // can resubmit an unchanged listing and waste a moderator's minute.
      // That is self-limiting — it is one document, it enters the queue
      // once, and it gets the same answer — and the alternative, demanding a
      // material change, breaks the ordinary case: rejections are most often
      // about a photo or a phone number, and a rule that only counted title,
      // price and category as material would leave exactly those sellers
      // stuck. Somebody abusing this is an account-level problem, and a
      // one-way door on a document is not the remedy for it.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.sellerId
        // 'approved' joins 'rejected' here, and a device session is what
        // found it. The form sends an approved listing back to review when a
        // MATERIAL_FIELD changes — title, description, price, category, city,
        // cover photo or partType (CreateListingScreen MATERIAL_FIELDS) —
        // because a listing whose price or photograph changed is not the
        // listing a moderator approved. That is the behaviour the comment
        // above argues for, and this clause simply never permitted it: only
        // rejected -> pending was allowed, so every material edit to a live
        // listing was refused with PERMISSION_DENIED and the seller was told
        // "nothing was created" about an update that changed nothing.
        //
        // Nothing widens here except the one transition. A seller still
        // cannot approve, cannot publish without canPost, and cannot touch
        // anybody else's listing. Pulling your own listing out of the market
        // costs you visibility and costs nobody else anything, which is why
        // it is safe to allow and was always safe to allow.
        && (
          request.resource.data.status == resource.data.status
          || (
            resource.data.status in ['rejected', 'approved']
            && request.resource.data.status == 'pending'
            && request.auth.token.canPost == true
          )
        )
        // A seller may edit their listing; they may not write the record of
        // who judged it. Without this the audit fields were writable by the
        // one person with a motive to forge them — the rule only ever
        // restricted `status`, so everything else on the document was fair
        // game. Found by the emulator test, not by reading the rule.
        //
        // isPromoted and promotedUntil sit in the same list for the same
        // reason: they are somebody else's decision about this listing, and
        // the seller is the one person with a motive to rewrite them.
        //
        // sellerId is the one that turned this from an audit finding into an
        // impersonation chain. The rule authorises on resource.data.sellerId
        // — the document as it stands — and never asked whether the incoming
        // one matched. So a seller could publish, get approved, and then
        // rewrite sellerId to a verified company's uid: useSellerListings
        // queries by that field, so the listing moves onto that company's
        // public profile, still carrying the original seller's phone number.
        //
        // Frozen through affectedKeys rather than the equality
        // `request.resource.data.sellerId == resource.data.sellerId`,
        // which would be equivalent for a changed value but not for a
        // deleted one — and a listing with no sellerId is unownable by
        // anybody, including the moderator who would have to clean it up.
        //
        // The badge, its job-post twin, the seller's displayed identity and
        // createdAt join it: all of them are read by cards that trust them,
        // and none of them are things an edit needs to touch. The listing
        // form already strips every one of these before it calls updateDoc,
        // so nothing legitimate changes here.
        //
        // Counters are frozen on this branch and remain writable on the
        // three counter branches below, which is what keeps a seller from
        // typing their own view count while a reader can still add one.
        //
        // Deliberately NOT frozen: title, description, price, media, city,
        // category, phone, saleStatus, soldAt, previousPrice, updatedAt,
        // roadsideAvailability and every category-specific field. Those are
        // the listing, and editing them is the point.
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['moderatedBy', 'moderatedAt', 'approvedAt',
                       'moderationNote', 'isPromoted', 'promotedUntil',
                       'sellerId', 'sellerVerified', 'verified',
                       'sellerName', 'sellerCompanyName', 'sellerPhotoUrl',
                       'sellerMemberSince', 'createdAt',
                       'viewCount', 'viewCountToday', 'viewCountDate',
                       'shareCount', 'contactCount', 'contactCountToday',
                       'contactCountDate', 'saveCount', 'reportCount',
                       'lastReportedAt', 'searchTokens', 'searchPairs'])
        // Renewal writes expiresAt from the dashboard, so this stays open —
        // bounded rather than frozen. See expiresAtOk.
        && expiresAtOk(request.resource.data)
        && listingTextOk(request.resource.data)
        && listingPriceOk(request.resource.data)
        && searchTokensOk(request.resource.data)
        && searchPairsOk(request.resource.data);

      // Moderation, from inside the app rather than from a laptop.
      //
      // Approving used to be possible only through the Admin SDK, which
      // bypasses these rules entirely — so the moderator was whoever held
      // the service-account key, a credential that also reads every private
      // message and cannot be revoked for one person. The `moderator` claim
      // can be, and is set only by scripts/grantModerator.js.
      //
      // The role is narrow on purpose: status, the timestamp that goes with
      // it, and a reason. A moderator has no business editing a price, a
      // phone number or a photo, and hasOnly() is what stops the role from
      // quietly becoming that.
      //
      // A moderator may not approve their own listing. It protects nothing
      // against the owner, who holds the master key regardless — it is here
      // for the second moderator, where self-approval is the first thing
      // that goes wrong.
      allow update: if request.auth != null
        && request.auth.token.moderator == true
        && request.auth.uid != resource.data.sellerId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'approvedAt', 'moderationNote',
                       'moderatedBy', 'moderatedAt',
                       'isPromoted', 'promotedUntil'])
        && request.resource.data.status in ['approved', 'rejected', 'pending']
        // A promotion has to end. Granting one writes the date it ends on,
        // and that date is bounded here rather than trusted from the
        // client: a moderator may renew as often as they like, and may not
        // hand out a decade by mistyping a number. Ninety days matches
        // PROMOTION_MAX_DAYS in src/data/promotion.js.
        //
        // The get() defaults matter. An update that leaves these fields
        // alone carries the previous values through request.resource.data,
        // so a listing that has never been promoted has no promotedUntil at
        // all and a bare read would fail the whole rule — which would block
        // ordinary approvals, not just promotions.
        && (
          request.resource.data.get('isPromoted', false) == false
          || (
            request.resource.data.promotedUntil is timestamp
            && request.resource.data.promotedUntil > request.time
            && request.resource.data.promotedUntil
                 < request.time + duration.value(90, 'd')
          )
        )
        // Who decided, recorded as the uid of whoever is signed in — not a
        // value the client chooses. With one moderator this is redundant;
        // with two it is the only answer to "who let that through?", and it
        // cannot be reconstructed later from decisions already made.
        //
        // The equality is the whole guard, and it is enough. An update that
        // omits moderatedBy carries the previous value through
        // request.resource.data — so if somebody else decided last, the
        // equality fails and the write is refused. A moderator cannot leave
        // another's name on their own decision.
        //
        // moderatedBy is deliberately NOT in the hasAll below, and this cost
        // a device session to learn. affectedKeys() lists the keys whose
        // value CHANGED; re-stamping moderatedBy with the same uid changes
        // nothing, so requiring it there refused the one case that matters
        // now that a rejection can be answered: the moderator who rejected a
        // listing deciding on the corrected version. With a single moderator
        // that turned the queue into a room with no exit — every
        // resubmission stuck in it forever — which is a worse failure than
        // the dead end the resubmission work set out to remove.
        //
        // moderatedAt stays, so every decision re-stamps its own time. It is
        // a serverTimestamp and therefore always changes, so it costs
        // nothing and keeps the audit trail honest about when.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasAll(['moderatedAt'])
        && request.resource.data.moderatedBy == request.auth.uid;

      // Lets a signed-in reader of an approved listing bump its view
      // counter — but ONLY that one field, and only by exactly 1 at a
      // time, so this can't be used to touch price/status/etc. or to
      // jump the count by an arbitrary amount in one write.
      //
      // Signed in, where it used to be anyone at all. These three rules
      // were the only writes in the whole database open to an
      // unauthenticated caller, and the Firebase config is in the app
      // bundle — so with no App Check, a script could drive billed writes
      // against any listing id it could read, forever, at the project

      // Counters are no longer writable from a client at all. They are
      // incremented by onCounterMarkerCreated, which fires when a reader
      // creates the counterMarkers document described above — one per person,
      // per listing, per kind, per day. See the block before this match.
      //
      // What was here before: three separate allow-update branches, each
      // permitting any signed-in account to add exactly one to viewCount,
      // shareCount or contactCount on any approved listing. Exactly one per
      // WRITE, with no limit on writes. The reasoning attached to them was
      // sound about everything except repetition — it argued carefully that a
      // counter bump could not touch the price and could not jump, and never
      // asked how many times it could happen.

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.sellerId;
    }

    // Follows are public in effect — a follower count is a public number —
    // but each document is writable only by the person doing the following,
    // and only under the composite id, so one account cannot manufacture
    // followers for itself or on anyone else's behalf.
    // Minted by a Cloud Function the first time two people open a
    // conversation. Its only job is to be a path the rating rule can test
    // for — rules cannot run queries, and a conversation id
    // (`listingId_buyerUid`) cannot be derived from two user ids.
    match /contacts/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow write: if false;
    }

    // A rating is public, written once per pair, and only by someone who
    // has actually spoken to the person being rated.
    match /ratings/{ratingId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.raterId == request.auth.uid
        // One rating per pair, and the id makes a second one impossible.
        && ratingId == request.auth.uid + '_' + request.resource.data.ratedId
        // Rating yourself would be free reputation.
        && request.resource.data.ratedId != request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.get('comment', '') is string
        && request.resource.data.get('comment', '').size() <= 500
        // The gate: written proof the two have met in the app. Checked
        // both ways round because the marker is stored under the sorted
        // pair and rules have no sort.
        && (
          exists(/databases/$(database)/documents/contacts/$(request.auth.uid + '_' + request.resource.data.ratedId))
          || exists(/databases/$(database)/documents/contacts/$(request.resource.data.ratedId + '_' + request.auth.uid))
        );

      // Editable — someone should be able to revise after a bad start is
      // put right — but never re-pointed at a different person.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.raterId
        && request.resource.data.raterId == resource.data.raterId
        && request.resource.data.ratedId == resource.data.ratedId
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.get('comment', '') is string
        && request.resource.data.get('comment', '').size() <= 500;

      allow delete: if request.auth != null && request.auth.uid == resource.data.raterId;
    }

    match /follows/{followId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.sellerId
        // Following yourself would inflate both of your own counters at once.
        && request.resource.data.sellerId != request.auth.uid;

      allow delete: if request.auth != null && request.auth.uid == resource.data.followerId;
    }

    // Counters shown on every profile: readable by anyone, writable by no
    // client. Only the Cloud Function triggers on follows/favorites write
    // here, which is what makes the numbers mean anything.
    // Directories of businesses that exist whether or not anyone here has
    // signed up: the brand distributors and the vehicle sales parks. Public
    // to read because a signed-out browser must see them, and writable by
    // nobody — these are curated by hand from the Firebase console, which
    // is what keeps a competitor from listing themselves as a Toyota
    // distributor straight from a phone.
    match /dealerships/{dealershipId} {
      allow read: if true;
      allow write: if false;
    }

    // Where "signalez-le et nous l'ajouterons" actually goes.
    //
    // The screen has always promised that a missing distributor can be
    // reported, and until now there was nothing to tap. The promise is kept
    // here rather than by loosening the block above, because a suggestion and
    // a dealership are not the same object: one is a tip about a firm that
    // may not hold any franchise at all, the other is the app asserting in
    // its own voice that it does.
    //
    // So this is a separate collection that the app never reads. Nothing
    // written here can appear anywhere — not filtered out, not sorted last:
    // no screen queries it. An admin reads it with
    // `node scripts/addDealership.js --suggestions`, checks the claim against
    // a published source, and only then writes the real row. That keeps the
    // one guarantee this directory exists to make: every name in it was
    // verified by a person, and no phone can shortcut that.
    match /dealershipSuggestions/{suggestionId} {
      // Not world-readable. A tip carries the submitter's uid and is nobody
      // else's business; the admin reads it with the service account, which
      // bypasses rules.
      allow read: if request.auth != null
        && request.auth.uid == resource.data.submittedBy;

      // `canPost` is deliberately NOT required here, unlike a park. A park
      // submission publishes a place; this one publishes nothing at all, so
      // the stricter gate would only hide the button from the people most
      // likely to know a distributor we missed.
      allow create: if request.auth != null
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 80
        && request.resource.data.brands is string
        && request.resource.data.brands.size() <= 200
        && (!('note' in request.resource.data)
          || request.resource.data.note == null
          || request.resource.data.note.size() <= 400);

      // Nothing edits a tip, including its author: it is evidence, and the
      // admin acts on what was actually sent.
      allow update, delete: if false;
    }

    // Parks, unlike dealerships, accept submissions from the app. A park is
    // a place — saying one exists is a much weaker claim than "official
    // Toyota distributor", and the useful moment to add one is standing in
    // it with GPS and a phone.
    //
    // A submitter can only ever create a *pending* row: publishing is still
    // a flip of `status` from the console, exactly like listing moderation.
    // So the trust boundary is unchanged — nothing reaches the public
    // directory without a human approving it — while the typing moves to
    // where the park is.
    match /carParks/{parkId} {
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && request.auth.uid == resource.data.submittedBy);

      // A submitted car park is a place added to Bénin's map, which is
      // publishing by another name.
      allow create: if request.auth != null
        && request.auth.token.canPost == true
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.commune is string
        && request.resource.data.commune.size() <= 80
        // Coordinates are optional — a submitter away from the park has
        // none — but if present they must be numbers inside Bénin's box,
        // not a pin dropped on another continent.
        && (!('latitude' in request.resource.data)
          || (request.resource.data.latitude is number
            && request.resource.data.latitude >= 6.0
            && request.resource.data.latitude <= 12.5))
        && (!('longitude' in request.resource.data)
          || (request.resource.data.longitude is number
            && request.resource.data.longitude >= 0.7
            && request.resource.data.longitude <= 3.9));

      // Approval and edits are console-only, same as dealerships.
      allow update, delete: if false;
    }

    match /sellerStats/{sellerId} {
      allow read: if true;
      allow write: if false;
    }

    match /favorites/{favoriteId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && favoriteId == request.auth.uid + '_' + request.resource.data.listingId;

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Liking an event is private, and shaped exactly like the two
    // favourites collections above: your own row, readable by you alone.
    match /eventLikes/{likeId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.eventId;

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Reacting is public — the point of a reaction is that the room and the
    // organiser can see it — so these are world-readable, and the card
    // totals them client-side.
    //
    // The document id is uid_eventId and the rule pins it to the writer.
    // That is what makes one person one reaction: there is no second id
    // they could write to in order to be counted twice, and no id belonging
    // to somebody else they could overwrite. `update` is allowed alongside
    // create so changing your mind from 🔥 to ❤️ is one write rather than a
    // delete and a re-create, which would briefly drop the count.
    match /eventReactions/{reactionId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && reactionId == request.auth.uid + '_' + request.resource.data.eventId;

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /jobFavorites/{favoriteId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && favoriteId == request.auth.uid + '_' + request.resource.data.jobId;

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // A candidate's application to a real (Firestore-backed) job listing —
    // never created for the static mockJobs.js sample postings, which have
    // no real employerUid to deliver to. `employerUid` is trusted from the
    // client at write time but pinned to match the listing's own sellerId,
    // so an applicant can't forge who receives it.
    match /jobApplications/{applicationId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.applicantUid || request.auth.uid == resource.data.employerUid);

      // Applying is posting to an employer, so it follows the same rule as
      // everything else somebody writes into the market. A job in Cotonou is
      // filled by somebody who can be reached on a Bénin number.
      //
      // One application per person per job, and the id is what makes a
      // second one impossible — the same device already used by favorites,
      // jobFavorites, eventLikes, follows, ratings and reports, and the one
      // collection that was written with an auto-id instead. With an
      // auto-id nothing stopped the same candidate applying twenty times:
      // twenty documents in the employer's list, twenty pushes from
      // notifyNewJobApplication, and twenty copies of the same CV left in
      // Storage.
      //
      // A second attempt now lands on an existing document, which makes it
      // an update, which this rule refuses — the update branch below
      // belongs to the employer. JobDetailScreen reads that refusal back as
      // "you have already applied" rather than as a generic failure.
      allow create: if request.auth != null
        && request.auth.token.canPost == true
        && request.resource.data.applicantUid == request.auth.uid
        && applicationId == request.resource.data.jobId + '_' + request.auth.uid
        && request.resource.data.employerUid ==
          get(/databases/$(database)/documents/listings/$(request.resource.data.jobId)).data.sellerId
        && get(/databases/$(database)/documents/listings/$(request.resource.data.jobId)).data.status == 'approved'
        && request.resource.data.status == 'new'
        // Free text an employer reads, bounded for the same reason a
        // listing description is.
        && textOk(request.resource.data, 'applicantMessage', 2000)
        && textOk(request.resource.data, 'applicantName', 120)
        && textOk(request.resource.data, 'applicantPhone', 32);

      // The employer can mark an application reviewed — nothing else about
      // it (who applied, what they said) is theirs to change.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.employerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.employerUid == resource.data.employerUid
        && request.resource.data.applicantUid == resource.data.applicantUid;
    }

    // Has either side of this conversation blocked the other?
    //
    // `blockedBy` is a map of uid -> bool, and unblocking writes false rather
    // than deleting the key, so this asks whether any value is true rather
    // than whether any key exists. One test covers both directions, which is
    // what the app means: the composer disappears for both people.
    function conversationBlocked(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId))
        .data.get('blockedBy', {}).values().hasAny([true]);
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participantIds);

      // A conversation is about a listing, between that listing's seller and
      // whoever tapped Message. All three of those were taken on trust.
      //
      // What that allowed: the id was unconstrained, `participantIds` was any
      // array containing the caller, and `listingTitle`, `listingThumbnail`
      // and `participantNames` were free text. So anybody could open a thread
      // against any uid, with a title and a display name of their choosing —
      // "Chez-Nous · Sécurité" arriving in somebody's inbox, in the app's own
      // chrome, asking for something. That is a phishing surface, and it does
      // not need a compromised account to build.
      //
      // Now: the id is the one openChat writes, the participants are exactly
      // the listing's seller and the caller, and the seller is read from the
      // listing rather than declared. A listing that has been deleted can no
      // longer be the subject of a NEW conversation, which is right — there
      // is nothing left to be about — and existing threads are untouched,
      // since none of this applies to update.
      allow create: if request.auth != null
        && conversationId == request.resource.data.listingId + '_' + request.auth.uid
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId ==
          get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.sellerId
        && request.resource.data.participantIds.hasOnly([
          request.resource.data.sellerId, request.auth.uid
        ])
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.sellerId in request.resource.data.participantIds
        && textOk(request.resource.data, 'listingTitle', 200);

      // A participant could rewrite every field on the thread, including
      // participantIds — so one of the two could add a third uid and hand a
      // stranger the whole message history, or repoint the thread at another
      // listing after the fact.
      //
      // Frozen: who is in it, who is who, and what it is about. Left open:
      // the last-message preview, the unread counters and blockedBy, which
      // are the four things the app writes on every send and every open.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['participantIds', 'buyerId', 'sellerId', 'listingId',
                      'createdAt']);

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        // A message body, bounded.
        //
        // The composer is multiline with no maxLength, and this rule
        // checked nothing about the payload, so a message could carry a
        // pasted document up to Firestore's 1 MiB document ceiling — read
        // back in full by both participants every time either opens the
        // thread, since the thread has no pagination.
        //
        // 4000 characters is far longer than anybody types on a phone and
        // still small enough that a thread stays cheap. `text` is absent
        // entirely on an image or voice message, which is why this is a
        // conditional rather than a required field.
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && (!('text' in request.resource.data)
            || (request.resource.data.text is string
              && request.resource.data.text.size() <= 4000))
          // Blocking, enforced where it binds.
          //
          // It was a field on the conversation that only the client and the
          // push trigger consulted: ChatScreen hid the composer and
          // sendMessagePush declined to notify. Neither stops a write. So
          // somebody told they had blocked a harasser kept receiving
          // messages — silently, which is worse than not offering the button
          // at all, because they had been told the problem was handled.
          //
          // Either direction blocks. That matches what the app shows: the
          // composer disappears for both people, not just for the one who
          // pressed the button.
          && !conversationBlocked(conversationId);

        allow delete: if request.auth != null && request.auth.uid == resource.data.senderId;
      }
    }

    // Write-only from the client — a report is only useful to a moderator,
    // and there's no in-app moderation UI yet, so nobody but the reporter
    // (write) needs access; reviewing reports happens out-of-band via the
    // admin SDK, same as pharmacy roster management.
    // Reports are write-only from the app: a reporter cannot read back
    // what anyone (including themselves) filed, and the reported party can
    // never see who reported them. Review happens through the Admin SDK.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        // One report per person per listing — the id makes a second
        // impossible, which is what keeps reportCount honest.
        && reportId == request.resource.data.listingId + '_' + request.auth.uid;

      // Amending your own report is fine; it changes no count.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.reporterId
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.listingId == resource.data.listingId;
    }
  }
}
