rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sellers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // A company account can submit its own RCCM/IFU/documents, but can
      // never write itself straight to 'verified' — this is the one and
      // only place that field is ever set, and it can only start at
      // 'pending' here (or be entirely absent, for individual accounts).
      //
      // `verifiedAt` may be present as long as it is null. `in` tests for
      // the key, not for a meaningful value, so requiring the key to be
      // absent rejected the client's own `verifiedAt: null` — which is how
      // signUpCompanySeller declares the field's initial state. That
      // mismatch denied every single company signup while leaving the auth
      // user created. Permitting an explicit null gives up nothing: a real
      // timestamp is still rejected, so the badge still can't be self-
      // granted.
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == 'pending')
        && (!('verifiedAt' in request.resource.data) || request.resource.data.verifiedAt == null);

      // Everything else about a seller's own profile stays freely
      // editable, but verificationStatus/verifiedAt are frozen from the
      // client's point of view after creation — those two only ever
      // change via the Admin SDK, i.e. an actual manual review, never
      // through the app itself.
      //
      // Once verified, the identity the review actually checked is frozen
      // too. Without this a company could clear manual review and then edit
      // its RCCM, IFU or trading name while keeping the badge — leaving a
      // Verified mark attesting to details nobody ever saw. Before
      // approval these stay editable, so a typo can still be corrected.
      // The status may also go from absent to 'pending' — that is a company
      // submitting its file for the first time onto a document some other
      // write created first (a push token, a seen-cursor). Without this the
      // company signup failed outright: the profile write became an update,
      // the status moved null -> 'pending', and the rule refused it. Only
      // that one transition is permitted; 'verified' remains impossible from
      // the client, which is the property this rule exists to protect.
      allow update: if request.auth != null && request.auth.uid == userId
        && (
          request.resource.data.get('verificationStatus', null) == resource.data.get('verificationStatus', null)
          || (resource.data.get('verificationStatus', null) == null
            && request.resource.data.get('verificationStatus', null) == 'pending')
        )
        && request.resource.data.get('verifiedAt', null) == resource.data.get('verifiedAt', null)
        && (
          resource.data.get('verificationStatus', '') != 'verified'
          || (
            request.resource.data.get('companyName', '') == resource.data.get('companyName', '')
            && request.resource.data.get('rccm', '') == resource.data.get('rccm', '')
            && request.resource.data.get('ifu', '') == resource.data.get('ifu', '')
          )
        );
    }

    // Public projection of a verified company — name, sector, city, logo,
    // and nothing else. Deliberately world-readable (the home feed shows it
    // to signed-out browsers too) precisely so that `sellers`, which holds
    // the phone number, RCCM, IFU and the representative's ID document, can
    // stay locked to its owner. Written only by the Admin SDK via
    // notifyCompanyVerificationDecision: no client write of any kind, so a
    // company cannot list itself here any more than it can grant itself the
    // badge.
    match /verifiedCompanies/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /advertisers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /ads/{adId} {
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && request.auth.uid == resource.data.advertiserId);

      // Same rule as listings: an advertisement is published content, and
      // Chez-Nous publishes from Bénin. The advertiser sign-up already
      // insists on a Bénin number, so this is the second lock rather than
      // the first — but the first one is in the app, and the app is not
      // where a determined writer goes.
      allow create: if request.auth != null
        && request.auth.token.canPost == true
        && request.resource.data.advertiserId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if request.auth != null
        && request.auth.uid == resource.data.advertiserId
        && resource.data.status != 'approved'
        && request.resource.data.status == resource.data.status;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.advertiserId
        && resource.data.status != 'approved';
    }

    // Null is the ordinary case: the field only exists on a listing whose
    // category or trade is "other".
    function customCategoryOk(data, field) {
      return data.get(field, null) == null
        || (data[field] is string && data[field].size() <= 40);
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && request.auth.uid == resource.data.sellerId)
        // A moderator has to see what they are being asked to judge. The
        // write rule below already lets them change a status; without this
        // they could approve a listing they had never been able to open,
        // which is not moderation, it is a coin toss.
        || (request.auth != null && request.auth.token.moderator == true);

      // Publishing is Bénin-only, and this is the line that makes that true.
      //
      // The app hides its posting buttons from accounts that cannot use them,
      // but a hidden button stops only the honest — anyone can write to
      // Firestore with the SDK. `canPost` is a custom claim, so it can only
      // be set by the claimPhoneCountry function, and that function only sets
      // it from a phone number Firebase itself verified by SMS.
      //
      // Reading stays open to the world, above. Someone in Paris or Lagos can
      // browse everything, message any seller and call any number; they
      // cannot add to the market, because we cannot put an SMS through to
      // their handset and an unreachable seller is where the scams start.
      // A seller may ask to be featured. They may not grant it to
      // themselves. The publish form used to write isPromoted straight from
      // its route params, and nothing here disagreed — so the "paid
      // placement" the code talks about cost nothing and never ended.
      // promotionRequested is the seller's half and says only that they
      // asked; isPromoted and promotedUntil are a moderator's to write.
      allow create: if request.auth != null
        && request.auth.token.canPost == true
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.get('isPromoted', false) == false
        && !request.resource.data.keys().hasAny(['promotedUntil'])
        // Free text the seller writes, which every future seller is then
        // offered as a suggestion. That is the reason for the ceiling: an
        // unbounded "category" is a paragraph pasted into a chip row, on
        // everyone's screen, for as long as the listing is approved.
        // Matches CUSTOM_CATEGORY_MAX in src/data/customCategories.js.
        && customCategoryOk(request.resource.data, 'customCategory')
        && customCategoryOk(request.resource.data, 'customTrade');

      // A rejection has to be survivable.
      //
      // This line used to read `request.resource.data.status ==
      // resource.data.status`, full stop, and that made 'rejected' a
      // terminal state: the seller could edit the listing all they liked
      // and it stayed rejected, invisible to everyone, forever. Their only
      // way back was to delete it and post it again, losing the document,
      // its views and its history — and nothing told them that. Meanwhile
      // listingRejectedNoReason, on their own screen, said "Edit it and it
      // will be reviewed again". The app was promising the one thing this
      // rule refused.
      //
      // So one transition opens, in one direction: rejected -> pending, by
      // the owner. Nothing else moves. A seller still cannot approve
      // anything, cannot take an approved listing out of review, and cannot
      // reject somebody else's.
      //
      // canPost is required on that branch and not on an ordinary edit,
      // because re-entering the queue is publishing — the same act the
      // create rule gates — while fixing a typo on a listing already in the
      // market is not. An account whose claim has lapsed can still correct
      // what it has; it cannot put something new in front of a moderator.
      //
      // Deliberately not required: that anything actually changed. A seller
      // can resubmit an unchanged listing and waste a moderator's minute.
      // That is self-limiting — it is one document, it enters the queue
      // once, and it gets the same answer — and the alternative, demanding a
      // material change, breaks the ordinary case: rejections are most often
      // about a photo or a phone number, and a rule that only counted title,
      // price and category as material would leave exactly those sellers
      // stuck. Somebody abusing this is an account-level problem, and a
      // one-way door on a document is not the remedy for it.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.sellerId
        && (
          request.resource.data.status == resource.data.status
          || (
            resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && request.auth.token.canPost == true
          )
        )
        // A seller may edit their listing; they may not write the record of
        // who judged it. Without this the audit fields were writable by the
        // one person with a motive to forge them — the rule only ever
        // restricted `status`, so everything else on the document was fair
        // game. Found by the emulator test, not by reading the rule.
        //
        // isPromoted and promotedUntil sit in the same list for the same
        // reason: they are somebody else's decision about this listing, and
        // the seller is the one person with a motive to rewrite them.
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['moderatedBy', 'moderatedAt', 'approvedAt',
                       'moderationNote', 'isPromoted', 'promotedUntil']);

      // Moderation, from inside the app rather than from a laptop.
      //
      // Approving used to be possible only through the Admin SDK, which
      // bypasses these rules entirely — so the moderator was whoever held
      // the service-account key, a credential that also reads every private
      // message and cannot be revoked for one person. The `moderator` claim
      // can be, and is set only by scripts/grantModerator.js.
      //
      // The role is narrow on purpose: status, the timestamp that goes with
      // it, and a reason. A moderator has no business editing a price, a
      // phone number or a photo, and hasOnly() is what stops the role from
      // quietly becoming that.
      //
      // A moderator may not approve their own listing. It protects nothing
      // against the owner, who holds the master key regardless — it is here
      // for the second moderator, where self-approval is the first thing
      // that goes wrong.
      allow update: if request.auth != null
        && request.auth.token.moderator == true
        && request.auth.uid != resource.data.sellerId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'approvedAt', 'moderationNote',
                       'moderatedBy', 'moderatedAt',
                       'isPromoted', 'promotedUntil'])
        && request.resource.data.status in ['approved', 'rejected', 'pending']
        // A promotion has to end. Granting one writes the date it ends on,
        // and that date is bounded here rather than trusted from the
        // client: a moderator may renew as often as they like, and may not
        // hand out a decade by mistyping a number. Ninety days matches
        // PROMOTION_MAX_DAYS in src/data/promotion.js.
        //
        // The get() defaults matter. An update that leaves these fields
        // alone carries the previous values through request.resource.data,
        // so a listing that has never been promoted has no promotedUntil at
        // all and a bare read would fail the whole rule — which would block
        // ordinary approvals, not just promotions.
        && (
          request.resource.data.get('isPromoted', false) == false
          || (
            request.resource.data.promotedUntil is timestamp
            && request.resource.data.promotedUntil > request.time
            && request.resource.data.promotedUntil
                 < request.time + duration.value(90, 'd')
          )
        )
        // Who decided, recorded as the uid of whoever is signed in — not a
        // value the client chooses. With one moderator this is redundant;
        // with two it is the only answer to "who let that through?", and it
        // cannot be reconstructed later from decisions already made.
        //
        // The equality is the whole guard, and it is enough. An update that
        // omits moderatedBy carries the previous value through
        // request.resource.data — so if somebody else decided last, the
        // equality fails and the write is refused. A moderator cannot leave
        // another's name on their own decision.
        //
        // moderatedBy is deliberately NOT in the hasAll below, and this cost
        // a device session to learn. affectedKeys() lists the keys whose
        // value CHANGED; re-stamping moderatedBy with the same uid changes
        // nothing, so requiring it there refused the one case that matters
        // now that a rejection can be answered: the moderator who rejected a
        // listing deciding on the corrected version. With a single moderator
        // that turned the queue into a room with no exit — every
        // resubmission stuck in it forever — which is a worse failure than
        // the dead end the resubmission work set out to remove.
        //
        // moderatedAt stays, so every decision re-stamps its own time. It is
        // a serverTimestamp and therefore always changes, so it costs
        // nothing and keeps the audit trail honest about when.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasAll(['moderatedAt'])
        && request.resource.data.moderatedBy == request.auth.uid;

      // Lets anyone who can already read an approved listing (including
      // signed-out browsers, per the read rule above) bump its view
      // counter — but ONLY that one field, and only by exactly 1 at a
      // time, so this can't be used to touch price/status/etc. or to
      // jump the count by an arbitrary amount in one write.
      allow update: if resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;

      // Sharing is the one other thing a reader can do that the seller
      // wants counted. Same shape as the view rule: this single field, +1
      // exactly, and only on a listing that is already public — so it can
      // neither touch the price nor be pumped in one write.
      allow update: if resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareCount'])
        && request.resource.data.shareCount == resource.data.get('shareCount', 0) + 1;

      // Same idea, for a viewer that's also reporting today's daily view
      // bucket (viewCountToday/viewCountDate) alongside the lifetime
      // counter — still exactly +1 on viewCount, and viewCountToday can
      // only ever go up by exactly 1 (same day) or reset to exactly 1
      // (new day), never jump or combine with any other field.
      allow update: if resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'viewCountToday', 'viewCountDate'])
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1
        && request.resource.data.viewCountDate is string
        && (
          (request.resource.data.viewCountDate == resource.data.get('viewCountDate', '')
            && request.resource.data.viewCountToday == resource.data.get('viewCountToday', 0) + 1)
          || (request.resource.data.viewCountDate != resource.data.get('viewCountDate', '')
            && request.resource.data.viewCountToday == 1)
        );

      // A contact — a tap on Appeler or WhatsApp — counted the same way a
      // view is, and for the same reason: the seller has no other way to
      // learn that eleven people called about the Corolla and nobody
      // called about the fridge. Views measure curiosity; this measures
      // intent, and it is the number that tells somebody whether the
      // photograph or the price is what is wrong.
      //
      // Exactly +1, nothing else touched, same daily bucket as viewCount so
      // "this week" can be answered without a second collection. Signed in
      // or not: a buyer who has never made an account still rings the
      // number, and refusing to count them would make the figure a measure
      // of registration.
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['contactCount', 'contactCountToday', 'contactCountDate'])
        && request.resource.data.contactCount == resource.data.get('contactCount', 0) + 1
        && request.resource.data.contactCountDate is string
        && (
          (request.resource.data.contactCountDate == resource.data.get('contactCountDate', '')
            && request.resource.data.contactCountToday == resource.data.get('contactCountToday', 0) + 1)
          || (request.resource.data.contactCountDate != resource.data.get('contactCountDate', '')
            && request.resource.data.contactCountToday == 1)
        );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.sellerId;
    }

    // Follows are public in effect — a follower count is a public number —
    // but each document is writable only by the person doing the following,
    // and only under the composite id, so one account cannot manufacture
    // followers for itself or on anyone else's behalf.
    // Minted by a Cloud Function the first time two people open a
    // conversation. Its only job is to be a path the rating rule can test
    // for — rules cannot run queries, and a conversation id
    // (`listingId_buyerUid`) cannot be derived from two user ids.
    match /contacts/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow write: if false;
    }

    // A rating is public, written once per pair, and only by someone who
    // has actually spoken to the person being rated.
    match /ratings/{ratingId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.raterId == request.auth.uid
        // One rating per pair, and the id makes a second one impossible.
        && ratingId == request.auth.uid + '_' + request.resource.data.ratedId
        // Rating yourself would be free reputation.
        && request.resource.data.ratedId != request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.get('comment', '') is string
        && request.resource.data.get('comment', '').size() <= 500
        // The gate: written proof the two have met in the app. Checked
        // both ways round because the marker is stored under the sorted
        // pair and rules have no sort.
        && (
          exists(/databases/$(database)/documents/contacts/$(request.auth.uid + '_' + request.resource.data.ratedId))
          || exists(/databases/$(database)/documents/contacts/$(request.resource.data.ratedId + '_' + request.auth.uid))
        );

      // Editable — someone should be able to revise after a bad start is
      // put right — but never re-pointed at a different person.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.raterId
        && request.resource.data.raterId == resource.data.raterId
        && request.resource.data.ratedId == resource.data.ratedId
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.get('comment', '') is string
        && request.resource.data.get('comment', '').size() <= 500;

      allow delete: if request.auth != null && request.auth.uid == resource.data.raterId;
    }

    match /follows/{followId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.sellerId
        // Following yourself would inflate both of your own counters at once.
        && request.resource.data.sellerId != request.auth.uid;

      allow delete: if request.auth != null && request.auth.uid == resource.data.followerId;
    }

    // Counters shown on every profile: readable by anyone, writable by no
    // client. Only the Cloud Function triggers on follows/favorites write
    // here, which is what makes the numbers mean anything.
    // Directories of businesses that exist whether or not anyone here has
    // signed up: the brand distributors and the vehicle sales parks. Public
    // to read because a signed-out browser must see them, and writable by
    // nobody — these are curated by hand from the Firebase console, which
    // is what keeps a competitor from listing themselves as a Toyota
    // distributor straight from a phone.
    match /dealerships/{dealershipId} {
      allow read: if true;
      allow write: if false;
    }

    // Where "signalez-le et nous l'ajouterons" actually goes.
    //
    // The screen has always promised that a missing distributor can be
    // reported, and until now there was nothing to tap. The promise is kept
    // here rather than by loosening the block above, because a suggestion and
    // a dealership are not the same object: one is a tip about a firm that
    // may not hold any franchise at all, the other is the app asserting in
    // its own voice that it does.
    //
    // So this is a separate collection that the app never reads. Nothing
    // written here can appear anywhere — not filtered out, not sorted last:
    // no screen queries it. An admin reads it with
    // `node scripts/addDealership.js --suggestions`, checks the claim against
    // a published source, and only then writes the real row. That keeps the
    // one guarantee this directory exists to make: every name in it was
    // verified by a person, and no phone can shortcut that.
    match /dealershipSuggestions/{suggestionId} {
      // Not world-readable. A tip carries the submitter's uid and is nobody
      // else's business; the admin reads it with the service account, which
      // bypasses rules.
      allow read: if request.auth != null
        && request.auth.uid == resource.data.submittedBy;

      // `canPost` is deliberately NOT required here, unlike a park. A park
      // submission publishes a place; this one publishes nothing at all, so
      // the stricter gate would only hide the button from the people most
      // likely to know a distributor we missed.
      allow create: if request.auth != null
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 80
        && request.resource.data.brands is string
        && request.resource.data.brands.size() <= 200
        && (!('note' in request.resource.data)
          || request.resource.data.note == null
          || request.resource.data.note.size() <= 400);

      // Nothing edits a tip, including its author: it is evidence, and the
      // admin acts on what was actually sent.
      allow update, delete: if false;
    }

    // Parks, unlike dealerships, accept submissions from the app. A park is
    // a place — saying one exists is a much weaker claim than "official
    // Toyota distributor", and the useful moment to add one is standing in
    // it with GPS and a phone.
    //
    // A submitter can only ever create a *pending* row: publishing is still
    // a flip of `status` from the console, exactly like listing moderation.
    // So the trust boundary is unchanged — nothing reaches the public
    // directory without a human approving it — while the typing moves to
    // where the park is.
    match /carParks/{parkId} {
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && request.auth.uid == resource.data.submittedBy);

      // A submitted car park is a place added to Bénin's map, which is
      // publishing by another name.
      allow create: if request.auth != null
        && request.auth.token.canPost == true
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.commune is string
        && request.resource.data.commune.size() <= 80
        // Coordinates are optional — a submitter away from the park has
        // none — but if present they must be numbers inside Bénin's box,
        // not a pin dropped on another continent.
        && (!('latitude' in request.resource.data)
          || (request.resource.data.latitude is number
            && request.resource.data.latitude >= 6.0
            && request.resource.data.latitude <= 12.5))
        && (!('longitude' in request.resource.data)
          || (request.resource.data.longitude is number
            && request.resource.data.longitude >= 0.7
            && request.resource.data.longitude <= 3.9));

      // Approval and edits are console-only, same as dealerships.
      allow update, delete: if false;
    }

    match /sellerStats/{sellerId} {
      allow read: if true;
      allow write: if false;
    }

    match /favorites/{favoriteId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && favoriteId == request.auth.uid + '_' + request.resource.data.listingId;

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Liking an event is private, and shaped exactly like the two
    // favourites collections above: your own row, readable by you alone.
    match /eventLikes/{likeId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.eventId;

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Reacting is public — the point of a reaction is that the room and the
    // organiser can see it — so these are world-readable, and the card
    // totals them client-side.
    //
    // The document id is uid_eventId and the rule pins it to the writer.
    // That is what makes one person one reaction: there is no second id
    // they could write to in order to be counted twice, and no id belonging
    // to somebody else they could overwrite. `update` is allowed alongside
    // create so changing your mind from 🔥 to ❤️ is one write rather than a
    // delete and a re-create, which would briefly drop the count.
    match /eventReactions/{reactionId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && reactionId == request.auth.uid + '_' + request.resource.data.eventId;

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /jobFavorites/{favoriteId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && favoriteId == request.auth.uid + '_' + request.resource.data.jobId;

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // A candidate's application to a real (Firestore-backed) job listing —
    // never created for the static mockJobs.js sample postings, which have
    // no real employerUid to deliver to. `employerUid` is trusted from the
    // client at write time but pinned to match the listing's own sellerId,
    // so an applicant can't forge who receives it.
    match /jobApplications/{applicationId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.applicantUid || request.auth.uid == resource.data.employerUid);

      // Applying is posting to an employer, so it follows the same rule as
      // everything else somebody writes into the market. A job in Cotonou is
      // filled by somebody who can be reached on a Bénin number.
      allow create: if request.auth != null
        && request.auth.token.canPost == true
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.employerUid ==
          get(/databases/$(database)/documents/listings/$(request.resource.data.jobId)).data.sellerId
        && get(/databases/$(database)/documents/listings/$(request.resource.data.jobId)).data.status == 'approved'
        && request.resource.data.status == 'new';

      // The employer can mark an application reviewed — nothing else about
      // it (who applied, what they said) is theirs to change.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.employerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.employerUid == resource.data.employerUid
        && request.resource.data.applicantUid == resource.data.applicantUid;
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participantIds);

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.buyerId == request.auth.uid;

      allow update: if request.auth != null && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        allow delete: if request.auth != null && request.auth.uid == resource.data.senderId;
      }
    }

    // Write-only from the client — a report is only useful to a moderator,
    // and there's no in-app moderation UI yet, so nobody but the reporter
    // (write) needs access; reviewing reports happens out-of-band via the
    // admin SDK, same as pharmacy roster management.
    // Reports are write-only from the app: a reporter cannot read back
    // what anyone (including themselves) filed, and the reported party can
    // never see who reported them. Review happens through the Admin SDK.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        // One report per person per listing — the id makes a second
        // impossible, which is what keeps reportCount honest.
        && reportId == request.resource.data.listingId + '_' + request.auth.uid;

      // Amending your own report is fine; it changes no count.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.reporterId
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.listingId == resource.data.listingId;
    }
  }
}
